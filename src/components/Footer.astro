---
const { siteName } = Astro.props;
---

<footer>
  <p>&copy; 2024 {siteName}</p>
</footer>

<style>
  footer {
    display: flex;
    align-items: center;
    justify-content: center;
    position: sticky;
    z-index: 1000;
    bottom: 0;
    height: 2.5rem;
    /* padding: 0.5rem 0; */
    border-top: 0.2rem solid dimgray;
    background-color: white;
  }
  footer p {
    font-size: small;
  }
</style>