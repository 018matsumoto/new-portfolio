---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section>
    <div>
      <h2>look?</h2>
    </div>
  </section>
</BaseLayout>

<style>
  section {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
    /* background-color: aqua; */
  }
  div {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20rem;
    height: 15rem;
    padding: 0.2rem 1rem;
    border-color: dimgray;
    border-style: solid;
    font-weight: bold;
    color: dimgray;
    /* border-radius: 0.5rem; */
    box-shadow: 0.5rem 0.5rem dimgray;
    margin: 0 0.3rem 0.3rem 0;
    background-color: white;
  }
</style>